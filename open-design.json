{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "parallel-design-exploration",
  "title": "Parallel Design Exploration",
  "version": "0.2.0",
  "description": "Standalone Open Design scenario for parallel prototyping: render multiple full design directions side by side, preserve prior rounds, and converge only when the user asks.",
  "license": "MIT",
  "author": {
    "name": "tungloong",
    "url": "https://github.com/tungloong"
  },
  "homepage": "https://github.com/tungloong/parallel-design-exploration",
  "tags": [
    "scenario",
    "design-exploration",
    "parallel-prototyping",
    "variants",
    "prototype",
    "ideation"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "od": {
    "kind": "scenario",
    "taskKind": "new-generation",
    "mode": "prototype",
    "surface": "web",
    "platform": "desktop",
    "scenario": "design-exploration",
    "preview": {
      "type": "html",
      "entry": "./examples/mobile-search/board.html",
      "motion": "static"
    },
    "useCase": {
      "query": "Run a parallel design exploration for my design brief. Generate {{variantCount}} materially different, fully rendered sibling prototypes and place them on one neutral exploration board. Treat my chat prompt as the brief. Do not make me pick a direction before rendering the alternatives. Do not pick a winner. Preserve prior rounds and append descendants on follow-up turns.",
      "exampleOutputs": [
        {
          "path": "./examples/mobile-search/board.html",
          "title": "Mobile search — three parallel interaction directions"
        }
      ]
    },
    "inputs": [
      {
        "name": "variantCount",
        "type": "number",
        "required": false,
        "label": "Variants per round",
        "default": 3
      }
    ],
    "context": {
      "skills": [
        {
          "path": "./SKILL.md"
        }
      ],
      "assets": [
        "./references/parallel-prototyping.md",
        "./references/exploration-canvas.md",
        "./references/checklist.md",
        "./templates/exploration-board.html",
        "./templates/exploration.schema.json",
        "./examples/mobile-ui-exploration.md",
        "./examples/mobile-search/board.html",
        "./examples/mobile-search/exploration.json"
      ],
      "atoms": [
        "discovery-question-form",
        "todo-write",
        "file-write",
        "live-artifact",
        "critique-theater"
      ]
    },
    "pipeline": {
      "stages": [
        {
          "id": "discovery",
          "atoms": [
            "discovery-question-form"
          ]
        },
        {
          "id": "plan",
          "atoms": [
            "todo-write"
          ]
        },
        {
          "id": "generate",
          "atoms": [
            "file-write",
            "live-artifact"
          ]
        },
        {
          "id": "critique",
          "atoms": [
            "critique-theater"
          ],
          "repeat": true,
          "until": "critique.score>=4 || iterations>=3"
        }
      ]
    },
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ]
  }
}
