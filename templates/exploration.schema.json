{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tungloong/parallel-design-exploration/blob/main/templates/exploration.schema.json",
  "title": "Parallel Design Exploration Manifest",
  "type": "object",
  "required": ["schemaVersion", "title", "rounds"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "brief": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "defaults": {
      "$ref": "#/$defs/displayDefaults"
    },
    "baseline": {
      "$ref": "#/$defs/baseline"
    },
    "rounds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/round"
      }
    },
    "promoted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sources"],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "note": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 200,
          "maximum": 5000
        },
        "height": {
          "type": "integer",
          "minimum": 200,
          "maximum": 5000
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "default": 1
        }
      }
    },
    "displayDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "viewport": {
          "$ref": "#/$defs/viewport"
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file"],
      "properties": {
        "id": {
          "type": "string",
          "const": "baseline"
        },
        "label": {
          "type": "string",
          "default": "Baseline"
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "problem": {
          "type": "string"
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "viewport": {
          "$ref": "#/$defs/viewport"
        }
      }
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "variants"],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "type": "string"
        },
        "feedback": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/variant"
          }
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parent", "name", "file", "hypothesis"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*[A-Z]$"
        },
        "parent": {
          "type": ["string", "null"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string"
        },
        "gains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sacrifices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "viewport": {
          "$ref": "#/$defs/viewport"
        },
        "status": {
          "type": "string",
          "enum": ["exploration", "promoted", "superseded"],
          "default": "exploration"
        }
      }
    }
  }
}
